# Browser-visible (inlined at build time)
# Indexer REST base. Unset means this site's own /api/v1 mount, which reads the indexer database server-side.
# NEXT_PUBLIC_INDEXER_URL=http://localhost:4100
# Optional live stream; without it, or while it is down, the explorer polls every 3 s.
# NEXT_PUBLIC_INDEXER_WS_URL=ws://localhost:4100/v1/ws
# Conductor API for plans, funding and signed actions. Unset shows the orchestrator as offline.
# NEXT_PUBLIC_CONDUCTOR_URL=http://localhost:4300
# The tree the landing page links to (56 hex characters).
# NEXT_PUBLIC_DEMO_TREE_ID=
# Development only: labelled sample data instead of the indexer. Ignored in production builds.
# NEXT_PUBLIC_CASCADE_FIXTURES=1

# Server only (never sent to the browser)
# DATABASE_URL=postgres://...            the indexer's Postgres, read by /api/v1
# CASCADE_NETWORK=preprod
# CASCADE_ORACLE_SKEY=ed25519e_sk1...    oracle account payment key only, signs receipts; never the treasury mnemonic
# BLOCKFROST_PROJECT_ID_PREPROD=...      optional, chain tip for the ops page
