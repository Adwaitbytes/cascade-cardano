{
  "name": "@cascade/x402",
  "version": "0.1.0",
  "private": true,
  "description": "x402 Cardano exact scheme for Cascade: masumi and script sell side, default-method buy side",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test/*.test.ts",
    "test:local": "vitest run test/local",
    "test:preprod": "CASCADE_PREPROD_A6=1 vitest run test/preprod"
  },
  "dependencies": {
    "@cascade/agent": "workspace:*",
    "@cascade/sdk": "workspace:*",
    "@cascade/shared": "workspace:*",
    "@x402/cardano": "2.28.0",
    "@x402/core": "2.28.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.3",
    "@lucid-evolution/lucid": "0.6.5",
    "@noble/curves": "2.4.0",
    "@types/node": "24.19.0",
    "dotenv": "17.2.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
