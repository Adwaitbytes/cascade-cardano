# Copy to .env and fill in. Never commit .env. Testnet (preprod) values only.

# LLM providers
ANTHROPIC_API_KEY=
SECOND_LLM_API_KEY=            # optional, lets Verifier B run on a different provider

# Cardano preprod
CARDANO_NETWORK=preprod
BLOCKFROST_PROJECT_ID_PREPROD=
CASCADE_TREASURY_MNEMONIC=     # preprod-only wallet funded from the testnet faucet
PREPROD_TUSDM_AVAILABLE=false  # set true only if the treasury holds preprod tUSDM
DEMETER_API_KEY=               # optional managed node, Ogmios and Kupo

# Git
GITHUB_TOKEN=
GIT_REMOTE_URL=

# Hosting (at least one path)
VERCEL_TOKEN=
DEPLOY_HOST=
DEPLOY_SSH_KEY_PATH=
RAILWAY_TOKEN=
