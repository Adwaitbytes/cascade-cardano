{
  "name": "@cascade/watchtower",
  "version": "0.1.0",
  "private": true,
  "description": "Cascade watchtower: selects and cranks permissionless transitions",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "pino": "10.3.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@cascade/policy": "workspace:*",
    "@cascade/sdk": "workspace:*",
    "@cascade/service-kit": "workspace:*",
    "@cascade/shared": "workspace:*",
    "@lucid-evolution/lucid": "0.6.5",
    "@opentelemetry/api": "1.9.1",
    "pg": "8.23.1",
    "zod": "4.6.5"
  }
}
