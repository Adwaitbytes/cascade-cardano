{
  "name": "@cascade/agent-cascade-coworker",
  "version": "0.1.0",
  "private": true,
  "description": "Cascade as a Sokosumi Coworker: runs each paid Task as a Cascade escrow tree and is paid through Masumi",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts"
  },
  "dependencies": {
    "@cascade/agent-kit": "workspace:*",
    "@cascade/orchestrator": "workspace:*",
    "@hono/node-server": "2.1.3",
    "@lucid-evolution/lucid": "0.6.5",
    "@temporalio/client": "1.24.0",
    "dotenv": "18.0.5",
    "hono": "4.13.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
