{
  "name": "@cascade/agent-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Shared wiring for the Cascade reference agents: environment, role signers, LLM client, ports",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cascade/agent": "workspace:*",
    "@cascade/orchestrator": "workspace:*",
    "@cascade/sdk": "workspace:*",
    "@cascade/shared": "workspace:*",
    "@cascade/x402": "workspace:*",
    "@lucid-evolution/lucid": "0.6.5",
    "@noble/curves": "2.4.0",
    "@x402/cardano": "2.28.0",
    "dotenv": "18.0.5",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
